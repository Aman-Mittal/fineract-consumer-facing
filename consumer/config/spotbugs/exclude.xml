<FindBugsFilter
        xmlns="https://github.com/spotbugs/filter/3.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">
    <!-- Generated by openapi-generator into build/; not our code. -->
    <Match>
        <Package name="~org\.apache\.fineract\.consumer\.infrastructure\.fineractclient\.generated(\..*)?"/>
    </Match>
    <Match>
        <Package name="~org\.apache\.fineract\.consumer\.client(\..*)?"/>
    </Match>
    <!--
        Excluded project-wide, as Fineract core excludes them (config/spotbugs/exclude.xml there).
        NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE: the generated Fineract models' getters are @Nullable, and
        SpotBugs cannot see that a getter null-checked on one line returns the same value on the next.
        EI_EXPOSE_REP / EI_EXPOSE_REP2 / MS_EXPOSE_REP: Lombok-generated accessors and constructor-injected
        Spring beans hold references by design.
    -->
    <Match>
        <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Bug pattern="MS_EXPOSE_REP"/>
    </Match>
    <!--
        The header value is echoed only after it matches ^[a-zA-Z0-9_.-]{1,64}$ (isValidCorrelationId),
        so it cannot carry CR/LF. SpotBugs does not follow the validation.
    -->
    <Match>
        <Class name="org.apache.fineract.consumer.infrastructure.correlation.filter.CorrelationIdFilter"/>
        <Bug pattern="HRS_REQUEST_PARAMETER_TO_HTTP_HEADER"/>
    </Match>
    <!--
        "{}: {}" logs the exception type and message as the whole line, which is the intended format;
        rewording it would change log output that operators may match on.
    -->
    <Match>
        <Class name="org.apache.fineract.consumer.infrastructure.exception.ConsumerExceptionHandler"/>
        <Bug pattern="SLF4J_SIGN_ONLY_FORMAT"/>
    </Match>
</FindBugsFilter>
